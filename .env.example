# Copy to .env, fill in, and chmod 600 .env. It's never committed.
# People and projects live in innerface.toml (see innerface.example.toml).

# Cloudflare Access: team name (the part before .cloudflareaccess.com) and the application's AUD tag
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# Token from Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=

# Only for docker-compose.builtin.yml, where the app signs people in itself (docs/sign-in.md). Leave empty otherwise.
# From a Google OAuth client of type "Web application" whose redirect URI is PUBLIC_URL followed by /signin/google/back
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How many days a browser stays signed in (30 if empty)
SESSION_DAYS=
# Addresses AI apps may be sent back to, separated by commas. Empty means Claude's and ChatGPT's.
CONNECTOR_REDIRECTS=

# One GitHub token per project, named by github_token_env in innerface.toml
GITHUB_TOKEN_MAIN=

# Encrypts tokens and connector secrets saved from the Settings screen. Make one with: openssl rand -base64 48
# Keep it safe: if it's lost or changed, those secrets must be typed in again. Without it they're saved as they are.
INNERFACE_SECRET_KEY=
# The address people open the app at, like https://ideas.example.com. Lets issues and webhooks link back to the card.
PUBLIC_URL=
# Set to 1 only if a webhook connector must reach an address on your own network. Allows http:// and private addresses.
WEBHOOK_ALLOW_PRIVATE=

# Email given to push services as a contact. Phone alerts stay off until this is set.
PUSH_CONTACT=

# Optional in-app assistant: none, anthropic or openai. Off by default; everything works without it.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
# Calls per person per day, a backstop against runaway spending
AI_DAILY_LIMIT=200
